@inherits LayoutComponentBase

<div class="page">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <main class="main-content">
        <header class="top-bar">
            <div class="top-bar-left">
                <div class="store-badge">
                    <span class="pulse-dot"></span>
                    <span class="store-text">Tienda en Vivo • Ventas Online</span>
                </div>
            </div>

            <div class="top-bar-right">
                <AuthorizeView>
                    <Authorized>
                        <div class="user-profile-pill">
                            <div class="user-avatar">
                                @(context.User.Identity?.Name?.Length > 0 ? context.User.Identity.Name.Substring(0, 1).ToUpper() : "U")
                            </div>
                            <div class="user-details">
                                <span class="user-name">@context.User.Identity?.Name</span>
                                <span class="user-badge">Activo</span>
                            </div>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <a href="login" class="btn-login-link">Iniciar sesión</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>

        <article class="content-container">
            @Body
        </article>
    </main>
</div>
