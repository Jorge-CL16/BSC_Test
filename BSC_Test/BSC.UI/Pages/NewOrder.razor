@page "/orders/new"
@attribute [Authorize(Roles = "Salesperson")]
@using System.Net.Http.Json
@using BSC.UI.Models
@inject HttpClient Http

<PageTitle>Nuevo Pedido | BSC Commerce</PageTitle>

<div class="page-header">
    <div>
        <h1>
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="var(--purple-700)" stroke-width="2">
                <circle cx="9" cy="21" r="1"></circle>
                <circle cx="20" cy="21" r="1"></circle>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
            </svg>
            Creación de Pedido
        </h1>
        <p>Genera una nueva orden de compra para un cliente agregando artículos disponibles en existencias.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert @(message.Contains("correctamente") ? "alert-success" : "alert-danger")">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
            @if (message.Contains("correctamente"))
            {
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
            }
            else
            {
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            }
        </svg>
        <span>@message</span>
    </div>
}

<div class="order-layout">
    <!-- Panel Izquierdo: Datos y Selección de Artículos -->
    <div class="order-form-column">
        <div class="card card-accent-purple">
            <div class="card-header">
                <div>
                    <h2>1. Datos del Cliente</h2>
                    <p>Ingresa el nombre o razón social del comprador.</p>
                </div>
            </div>

            <div class="form-group">
                <label for="customerName">Nombre Completo del Cliente</label>
                <InputText id="customerName" @bind-Value="order.CustomerName" class="form-control" placeholder="Ej. Ana Martínez o Comercializadora del Norte" />
            </div>
        </div>

        <div class="card card-accent-gold">
            <div class="card-header">
                <div>
                    <h2>2. Agregar Productos</h2>
                    <p>Selecciona artículos disponibles para añadir a la orden.</p>
                </div>
            </div>

            @if (isLoadingProducts)
            {
                <div style="text-align: center; padding: 2rem;">
                    <div class="loader-spinner" style="margin: 0 auto 0.5rem auto;"></div>
                    <p>Consultando catálogo y existencias...</p>
                </div>
            }
            else
            {
                <div class="form-group" style="margin-bottom: 1.25rem;">
                    <label for="productSelect">Seleccionar Producto</label>
                    <select id="productSelect" @bind="selectedProductId" class="form-control">
                        <option value="0">-- Elige un artículo de la lista --</option>
                        @foreach (var product in products)
                        {
                            <option value="@product.ProductId" disabled="@(product.StockQuantity <= 0)">
                                @product.Name (Existencias: @product.StockQuantity) @(product.StockQuantity <= 0 ? "- [Agotado]" : "")
                            </option>
                        }
                    </select>
                </div>

                <div class="form-row" style="align-items: flex-end; margin-bottom: 1.5rem;">
                    <div class="form-group">
                        <label for="productQty">Cantidad a Solicitar</label>
                        <InputNumber id="productQty" @bind-Value="selectedQuantity" min="1" class="form-control" />
                    </div>
                    <div>
                        <button type="button" class="btn btn-primary" @onclick="AddItem" style="width: 100%;">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                            <span>Agregar al Carrito</span>
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Panel Derecho: Carrito y Resumen del Pedido -->
    <div class="order-summary-column">
        <div class="card card-accent-purple" style="position: sticky; top: 5.5rem;">
            <div class="card-header">
                <div>
                    <h2>Resumen del Pedido</h2>
                    <p>Artículos que conformarán la orden final.</p>
                </div>
                <span class="badge badge-gold">@order.Items.Sum(i => i.Quantity) Artículos</span>
            </div>

            @if (order.Items.Count == 0)
            {
                <div class="empty-cart-state">
                    <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="var(--purple-300)" stroke-width="1.5">
                        <circle cx="9" cy="21" r="1"></circle>
                        <circle cx="20" cy="21" r="1"></circle>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                    </svg>
                    <p>No has agregado artículos aún.</p>
                    <span style="font-size: 0.8rem; color: var(--text-light);">Selecciona productos del panel izquierdo para comenzar.</span>
                </div>
            }
            else
            {
                <ul class="cart-list">
                    @foreach (var item in order.Items)
                    {
                        var product = products.FirstOrDefault(product => product.ProductId == item.ProductId);
                        <li class="cart-item">
                            <div style="display: flex; flex-direction: column; gap: 0.2rem;">
                                <span class="cart-item-name">@(product?.Name ?? $"Producto #{item.ProductId}")</span>
                                <span style="font-size: 0.8rem; color: var(--text-muted);">
                                    Cantidad: <strong style="color: var(--purple-800);">@item.Quantity</strong> pieza(s)
                                </span>
                            </div>
                            <button type="button" class="btn btn-sm btn-danger" title="Quitar artículo" @onclick="() => RemoveItem(item)">
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="3 6 5 6 21 6"></polyline>
                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                </svg>
                                <span>Eliminar</span>
                            </button>
                        </li>
                    }
                </ul>

                <div class="order-total-summary">
                    <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem; font-size: 0.95rem;">
                        <span style="color: var(--text-muted);">Total de líneas:</span>
                        <strong>@order.Items.Count</strong>
                    </div>
                    <div style="display: flex; justify-content: space-between; margin-bottom: 1.25rem; font-size: 1.15rem; font-weight: 800; color: var(--purple-950);">
                        <span>Total de unidades:</span>
                        <span style="color: var(--purple-700);">@order.Items.Sum(i => i.Quantity) unidades</span>
                    </div>

                    <button type="button" class="btn btn-gold btn-block" @onclick="CreateOrder" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="btn-spinner"></span>
                            <span>Procesando pedido...</span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            <span>Confirmar y Enviar Pedido</span>
                        }
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .page-header {
        margin-bottom: 2rem;
    }

    .empty-cart-state {
        text-align: center;
        padding: 3rem 1.5rem;
        border: 2px dashed var(--purple-200);
        border-radius: var(--radius-lg);
        background: var(--purple-50);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
    }

    .empty-cart-state p {
        margin: 0;
        font-weight: 600;
        color: var(--purple-900);
    }

    .order-total-summary {
        background: var(--purple-50);
        border: 1px solid var(--purple-200);
        border-radius: var(--radius-md);
        padding: 1.25rem;
    }
</style>

@code {
    private List<ProductDto> products = [];
    private CreateOrderRequest order = new();
    private int selectedProductId;
    private int selectedQuantity = 1;
    private bool isLoadingProducts = true;
    private bool isSaving;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            products = await Http.GetFromJsonAsync<List<ProductDto>>("api/products") ?? [];
        }
        catch (Exception exception)
        {
            message = $"No fue posible cargar los productos: {exception.Message}";
        }
        finally
        {
            isLoadingProducts = false;
        }
    }

    private void AddItem()
    {
        message = null;

        if (selectedProductId <= 0 || selectedQuantity <= 0)
        {
            message = "Selecciona un producto y una cantidad válida.";
            return;
        }

        var existingItem = order.Items.FirstOrDefault(
            item => item.ProductId == selectedProductId);

        if (existingItem is not null)
        {
            existingItem.Quantity += selectedQuantity;
        }
        else
        {
            order.Items.Add(new OrderItemRequest
            {
                ProductId = selectedProductId,
                Quantity = selectedQuantity
            });
        }

        selectedProductId = 0;
        selectedQuantity = 1;
    }

    private void RemoveItem(OrderItemRequest item)
    {
        order.Items.Remove(item);
    }

    private async Task CreateOrder()
    {
        message = null;

        if (string.IsNullOrWhiteSpace(order.CustomerName) || order.Items.Count == 0)
        {
            message = "Captura el cliente y agrega al menos un producto.";
            return;
        }

        isSaving = true;

        try
        {
            var response = await Http.PostAsJsonAsync("api/orders", order);

            if (!response.IsSuccessStatusCode)
            {
                message = "No fue posible crear el pedido. Verifica las existencias.";
                return;
            }

            var createdOrder = await response.Content.ReadFromJsonAsync<OrderCreatedDto>();
            message = $"Pedido {createdOrder?.OrderId} creado correctamente.";
            order = new();
        }
        catch (Exception exception)
        {
            message = $"Ocurrió un error: {exception.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}
