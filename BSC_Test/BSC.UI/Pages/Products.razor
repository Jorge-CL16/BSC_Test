@page "/products"
@attribute [Authorize]
@using System.Net.Http.Json
@using BSC.UI.Models
@inject HttpClient Http

<PageTitle>Catálogo de Productos | BSC Commerce</PageTitle>

<div class="page-header">
    <div>
        <h1>
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="var(--purple-700)" stroke-width="2">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                <line x1="12" y1="22.08" x2="12" y2="12"></line>
            </svg>
            Catálogo de Productos
        </h1>
        <p>Administración del catálogo, control de existencias por artículo y estado de venta.</p>
    </div>
</div>

@if (isLoading)
{
    <div class="card" style="text-align: center; padding: 3rem;">
        <div class="loader-spinner" style="margin: 0 auto 1rem auto;"></div>
        <p>Cargando inventario de productos...</p>
    </div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <span>@errorMessage</span>
    </div>
}
else
{
    <div class="card card-accent-purple">
        <div class="card-header">
            <div>
                <h2>Lista de Artículos (@products.Count)</h2>
                <p>Visualiza el estado y disponibilidad de cada artículo en la plataforma.</p>
            </div>
        </div>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Clave / SKU</th>
                        <th>Nombre del Producto</th>
                        <th>Existencias</th>
                        <th>Estado</th>
                        <AuthorizeView Roles="Administrator,AdministrativeStaff">
                            <Authorized>
                                <th style="text-align: right;">Acciones</th>
                            </Authorized>
                        </AuthorizeView>
                    </tr>
                </thead>
                <tbody>
                    @if (products.Count == 0)
                    {
                        <tr>
                            <td colspan="5" style="text-align: center; padding: 2rem; color: var(--text-muted);">
                                No se encontraron productos registrados en el catálogo.
                            </td>
                        </tr>
                    }
                    @foreach (var product in products)
                    {
                        <tr>
                            <td>
                                <span class="badge badge-purple">@product.ProductKey</span>
                            </td>
                            <td>
                                <strong style="color: var(--purple-950);">@product.Name</strong>
                            </td>
                            <td>
                                @if (product.StockQuantity > 10)
                                {
                                    <span class="badge badge-success">@product.StockQuantity disponibles</span>
                                }
                                else if (product.StockQuantity > 0)
                                {
                                    <span class="badge badge-warning">@product.StockQuantity (Bajo)</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">0 (Agotado)</span>
                                }
                            </td>
                            <td>
                                @if (product.IsActive)
                                {
                                    <span class="badge badge-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">Inactivo</span>
                                }
                            </td>
                            <AuthorizeView Roles="Administrator,AdministrativeStaff">
                                <Authorized Context="productActionsUser">
                                    <td style="text-align: right;">
                                        <button type="button" class="btn btn-sm btn-outline" @onclick="() => StartEditing(product)">
                                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                            </svg>
                                            <span>Editar</span>
                                        </button>
                                    </td>
                                </Authorized>
                            </AuthorizeView>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="forms-grid">
    <!-- Formulario para Registrar Producto -->
    <AuthorizeView Roles="Administrator,AdministrativeStaff">
        <Authorized Context="authorizedUser">
            <div class="card card-accent-gold">
                <div class="card-header">
                    <div>
                        <h2>Registrar Nuevo Producto</h2>
                        <p>Agrega un nuevo artículo con su stock inicial a la tienda.</p>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(createMessage))
                {
                    <div class="alert @(createMessage.Contains("correctamente") ? "alert-success" : "alert-danger")">
                        <span>@createMessage</span>
                    </div>
                }

                <EditForm Model="newProduct" OnValidSubmit="CreateProduct">
                    <div class="form-row">
                        <div class="form-group">
                            <label>Nombre del Producto</label>
                            <InputText @bind-Value="newProduct.Name" class="form-control" placeholder="Ej. Smart Watch Pro Series" />
                        </div>
                        <div class="form-group">
                            <label>Existencia Inicial</label>
                            <InputNumber @bind-Value="newProduct.StockQuantity" class="form-control" placeholder="0" />
                        </div>
                    </div>
                    <div>
                        <button type="submit" class="btn btn-gold">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                            <span>Guardar Producto</span>
                        </button>
                    </div>
                </EditForm>
            </div>
        </Authorized>
    </AuthorizeView>

    <!-- Formulario para Editar Producto -->
    @if (editingProduct is not null)
    {
        <div class="card card-accent-purple" style="border: 2px solid var(--purple-400);">
            <div class="card-header">
                <div>
                    <h2>Editar Producto: #@editingProductId</h2>
                    <p>Actualiza la información básica o el estado de visibilidad del artículo.</p>
                </div>
            </div>

            <EditForm Model="editingProduct" OnValidSubmit="UpdateProduct">
                <div class="form-row">
                    <div class="form-group">
                        <label>Nombre del Producto</label>
                        <InputText @bind-Value="editingProduct.Name" class="form-control" />
                    </div>
                    <div class="form-group" style="justify-content: center;">
                        <label style="flex-direction: row; align-items: center; cursor: pointer;">
                            <InputCheckbox @bind-Value="editingProduct.IsActive" />
                            <span>Producto Disponible y Activo para Venta</span>
                        </label>
                    </div>
                </div>
                <div style="display: flex; gap: 0.75rem; margin-top: 0.5rem;">
                    <button type="submit" class="btn btn-primary">
                        <span>Guardar Cambios</span>
                    </button>
                    <button type="button" class="btn btn-secondary" @onclick="CancelEditing">
                        <span>Cancelar</span>
                    </button>
                </div>
            </EditForm>
        </div>
    }
</div>

<style>
    .page-header {
        margin-bottom: 2rem;
    }

    .forms-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
        gap: 1.5rem;
    }
</style>

@code {
    private List<ProductDto> products = [];
    private CreateProductRequest newProduct = new();
    private UpdateProductRequest? editingProduct;
    private int editingProductId;
    private bool isLoading = true;
    private string? errorMessage;
    private string? createMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            products = await Http.GetFromJsonAsync<List<ProductDto>>("api/products") ?? [];
        }
        catch (Exception exception)
        {
            errorMessage = $"No fue posible cargar los productos: {exception.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CreateProduct()
    {
        createMessage = null;

        var response = await Http.PostAsJsonAsync("api/products", newProduct);

        if (!response.IsSuccessStatusCode)
        {
            createMessage = "No fue posible registrar el producto.";
            return;
        }

        createMessage = "Producto registrado correctamente.";
        newProduct = new();
        await LoadProducts();
    }

    private void StartEditing(ProductDto product)
    {
        editingProductId = product.ProductId;
        editingProduct = new UpdateProductRequest
        {
            Name = product.Name,
            IsActive = product.IsActive
        };
        createMessage = null;
    }

    private void CancelEditing()
    {
        editingProduct = null;
        editingProductId = 0;
    }

    private async Task UpdateProduct()
    {
        if (editingProduct is null)
            return;

        var response = await Http.PutAsJsonAsync(
            $"api/products/{editingProductId}",
            editingProduct);

        createMessage = response.IsSuccessStatusCode
            ? "Producto actualizado correctamente."
            : "No fue posible actualizar el producto.";

        if (response.IsSuccessStatusCode)
        {
            CancelEditing();
            await LoadProducts();
        }
    }
}
