@page "/stock"
@attribute [Authorize(Roles = "Administrator,AdministrativeStaff")]
@using System.Net.Http.Json
@using BSC.UI.Models
@inject HttpClient Http

<PageTitle>Existencias e Inventario | BSC Commerce</PageTitle>

<div class="page-header">
    <div>
        <h1>
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="var(--purple-700)" stroke-width="2">
                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
            </svg>
            Control de Existencias
        </h1>
        <p>Monitorea los niveles de disponibilidad de los productos en almacén y registra ajustes de inventario.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(actionMessage))
{
    <div class="alert @(actionMessage.Contains("correctamente") ? "alert-success" : "alert-danger")">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <span>@actionMessage</span>
    </div>
}

@if (isLoading)
{
    <div class="card" style="text-align: center; padding: 3rem;">
        <div class="loader-spinner" style="margin: 0 auto 1rem auto;"></div>
        <p>Cargando reporte de existencias...</p>
    </div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <span>@errorMessage</span>
    </div>
}
else
{
    <div class="card card-accent-purple">
        <div class="card-header">
            <div>
                <h2>Niveles de Inventario (@products.Count)</h2>
                <p>Resumen de existencias en tiempo real.</p>
            </div>
        </div>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Existencia Actual</th>
                        <th>Estado de Stock</th>
                        <th>Visibilidad</th>
                    </tr>
                </thead>
                <tbody>
                    @if (products.Count == 0)
                    {
                        <tr>
                            <td colspan="4" style="text-align: center; padding: 2rem; color: var(--text-muted);">
                                No hay productos en la base de inventario.
                            </td>
                        </tr>
                    }
                    @foreach (var product in products)
                    {
                        <tr>
                            <td>
                                <strong style="color: var(--purple-950);">@product.ProductName</strong>
                            </td>
                            <td>
                                <span style="font-weight: 700; font-size: 1.05rem; color: var(--purple-900);">
                                    @product.StockQuantity
                                </span>
                                <span style="font-size: 0.8rem; color: var(--text-muted);"> unidades</span>
                            </td>
                            <td>
                                @if (product.StockStatus == "InStock")
                                {
                                    <span class="badge badge-success">En existencia</span>
                                }
                                else if (product.StockStatus == "LowStock")
                                {
                                    <span class="badge badge-warning">Existencia baja</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">Agotado</span>
                                }
                            </td>
                            <td>
                                @if (product.IsActive)
                                {
                                    <span class="badge badge-purple">Activo</span>
                                }
                                else
                                {
                                    <span class="badge" style="background: #f3f4f6; color: #6b7280; border: 1px solid #e5e7eb;">Inactivo</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Tarjeta para Ajustar Inventario -->
<div class="card card-accent-gold" style="max-width: 800px;">
    <div class="card-header">
        <div>
            <h2>Registrar Ajuste de Inventario</h2>
            <p>Incrementa o disminuye el stock ante recepciones, mermas o inventario físico.</p>
        </div>
    </div>

    <EditForm Model="adjustment" OnValidSubmit="AdjustInventory">
        <div class="form-group">
            <label for="stockProductSelect">Producto a Ajustar</label>
            <select id="stockProductSelect" @bind="selectedProductId" class="form-control">
                <option value="0">-- Selecciona un producto para aplicar el ajuste --</option>
                @foreach (var product in products)
                {
                    <option value="@product.ProductId">
                        @product.ProductName (Existencias actuales: @product.StockQuantity)
                    </option>
                }
            </select>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label for="qtyChange">Cambio de Cantidad (+ / -)</label>
                <InputNumber id="qtyChange" @bind-Value="adjustment.QuantityChange" class="form-control" placeholder="Ej. 10 o -5" />
                <span style="font-size: 0.78rem; color: var(--text-muted);">Usa números positivos para entradas y negativos para salidas.</span>
            </div>

            <div class="form-group">
                <label for="adjReason">Motivo o Justificación</label>
                <InputText id="adjReason" @bind-Value="adjustment.Reason" class="form-control" placeholder="Ej. Recepción de proveedor, merma o auditoría" />
            </div>
        </div>

        <div>
            <button type="submit" class="btn btn-gold" disabled="@(selectedProductId <= 0)">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>Aplicar Ajuste de Inventario</span>
            </button>
        </div>
    </EditForm>
</div>

<style>
    .page-header {
        margin-bottom: 2rem;
    }
</style>

@code {
    private List<StockReportDto> products = [];
    private AdjustInventoryRequest adjustment = new();
    private int selectedProductId;
    private bool isLoading = true;
    private string? errorMessage;
    private string? actionMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadStock();
    }

    private async Task LoadStock()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            products = await Http.GetFromJsonAsync<List<StockReportDto>>("api/products/stock") ?? [];
        }
        catch (Exception exception)
        {
            errorMessage = $"No fue posible cargar las existencias: {exception.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AdjustInventory()
    {
        actionMessage = null;

        if (selectedProductId <= 0)
        {
            actionMessage = "Por favor selecciona un producto válido.";
            return;
        }

        var response = await Http.PostAsJsonAsync(
            $"api/products/{selectedProductId}/inventory-adjustments",
            adjustment);

        if (!response.IsSuccessStatusCode)
        {
            actionMessage = "No fue posible aplicar el ajuste de inventario.";
            return;
        }

        actionMessage = "Ajuste de inventario aplicado correctamente.";
        adjustment = new();
        selectedProductId = 0;
        await LoadStock();
    }
}
