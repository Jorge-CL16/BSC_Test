@page "/users"
@attribute [Authorize(Roles = "Administrator")]
@using System.Net.Http.Json
@using BSC.UI.Models
@inject HttpClient Http

<PageTitle>Administración de Usuarios | BSC Commerce</PageTitle>

<div class="page-header">
    <div>
        <h1>
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="var(--purple-700)" stroke-width="2">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
            Administración de Usuarios
        </h1>
        <p>Gestión de cuentas de acceso, roles corporativos y control de activación del personal.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(actionMessage))
{
    <div class="alert @(actionMessage.Contains("correctamente") ? "alert-success" : "alert-danger")">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <span>@actionMessage</span>
    </div>
}

@if (isLoading)
{
    <div class="card" style="text-align: center; padding: 3rem;">
        <div class="loader-spinner" style="margin: 0 auto 1rem auto;"></div>
        <p>Cargando directorio de usuarios...</p>
    </div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <span>@errorMessage</span>
    </div>
}
else
{
    <div class="card card-accent-purple">
        <div class="card-header">
            <div>
                <h2>Directorio de Cuentas (@users.Count)</h2>
                <p>Personal registrado con permisos para operar la plataforma.</p>
            </div>
        </div>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Colaborador</th>
                        <th>Correo Electrónico</th>
                        <th>Rol / Perfil</th>
                        <th>Estado</th>
                        <th style="text-align: right;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (users.Count == 0)
                    {
                        <tr>
                            <td colspan="5" style="text-align: center; padding: 2rem; color: var(--text-muted);">
                                No se encontraron usuarios registrados en el sistema.
                            </td>
                        </tr>
                    }
                    @foreach (var user in users)
                    {
                        <tr>
                            <td>
                                <div style="display: flex; align-items: center; gap: 0.75rem;">
                                    <div class="user-avatar-sm">
                                        @(user.Name.Length > 0 ? user.Name.Substring(0, 1).ToUpper() : "U")
                                    </div>
                                    <strong style="color: var(--purple-950);">@user.Name</strong>
                                </div>
                            </td>
                            <td>
                                <span style="color: var(--text-muted);">@user.Email</span>
                            </td>
                            <td>
                                @if (user.UserRole == 1)
                                {
                                    <span class="badge badge-purple">Administrador</span>
                                }
                                else if (user.UserRole == 2)
                                {
                                    <span class="badge" style="background: var(--info-bg); color: var(--info); border: 1px solid var(--info-border);">
                                        Personal administrativo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-gold">Vendedor</span>
                                }
                            </td>
                            <td>
                                @if (user.Active)
                                {
                                    <span class="badge badge-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">Desactivado</span>
                                }
                            </td>
                            <td style="text-align: right;">
                                <button type="button" class="btn btn-sm @(user.Active ? "btn-outline" : "btn-gold")" @onclick="() => SetActive(user)">
                                    @if (user.Active)
                                    {
                                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                            <circle cx="12" cy="12" r="10"></circle>
                                            <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
                                        </svg>
                                        <span>Desactivar</span>
                                    }
                                    else
                                    {
                                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                            <polyline points="20 6 9 17 4 12"></polyline>
                                        </svg>
                                        <span>Activar</span>
                                    }
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Formulario para Crear Usuario -->
<div class="card card-accent-gold" style="max-width: 900px;">
    <div class="card-header">
        <div>
            <h2>Crear Nuevo Usuario</h2>
            <p>Registra un nuevo miembro del equipo y asígnale su rol en la plataforma.</p>
        </div>
    </div>

    <EditForm Model="newUser" OnValidSubmit="CreateUser">
        <div class="form-row">
            <div class="form-group">
                <label for="userName">Nombre Completo</label>
                <InputText id="userName" @bind-Value="newUser.Name" class="form-control" placeholder="Ej. Carlos Mendoza" />
            </div>

            <div class="form-group">
                <label for="userEmail">Correo Electrónico</label>
                <InputText id="userEmail" @bind-Value="newUser.Email" class="form-control" placeholder="carlos@empresa.com" />
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label for="userPass">Contraseña Inicial</label>
                <InputText id="userPass" type="password" @bind-Value="newUser.Password" class="form-control" placeholder="••••••••" />
            </div>

            <div class="form-group">
                <label for="userRole">Perfil de Usuario</label>
                <select id="userRole" @bind="newUser.UserRole" class="form-control">
                    <option value="1">Administrador</option>
                    <option value="2">Personal administrativo</option>
                    <option value="3">Vendedor</option>
                </select>
            </div>
        </div>

        <div>
            <button type="submit" class="btn btn-gold">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <line x1="20" y1="8" x2="20" y2="14"></line>
                    <line x1="23" y1="11" x2="17" y2="11"></line>
                </svg>
                <span>Crear Cuenta de Usuario</span>
            </button>
        </div>
    </EditForm>
</div>

<style>
    .page-header {
        margin-bottom: 2rem;
    }

    .user-avatar-sm {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--gold-400), var(--gold-300));
        color: var(--purple-950);
        font-weight: 800;
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: var(--shadow-sm);
        flex-shrink: 0;
    }
</style>

@code {
    private List<UserDto> users = [];
    private CreateUserRequest newUser = new();
    private bool isLoading = true;
    private string? errorMessage;
    private string? actionMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            users = await Http.GetFromJsonAsync<List<UserDto>>("api/users") ?? [];
        }
        catch (Exception exception)
        {
            errorMessage = $"No fue posible cargar los usuarios: {exception.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CreateUser()
    {
        actionMessage = null;
        var response = await Http.PostAsJsonAsync("api/users", newUser);

        if (!response.IsSuccessStatusCode)
        {
            actionMessage = "No fue posible crear el usuario.";
            return;
        }

        actionMessage = "Usuario creado correctamente.";
        newUser = new();
        await LoadUsers();
    }

    private async Task SetActive(UserDto user)
    {
        var response = await Http.PutAsJsonAsync(
            $"api/users/{user.UserId}/active",
            !user.Active);

        actionMessage = response.IsSuccessStatusCode
            ? "Estado del usuario actualizado correctamente."
            : "No fue posible actualizar el estado.";

        if (response.IsSuccessStatusCode)
            await LoadUsers();
    }
}
