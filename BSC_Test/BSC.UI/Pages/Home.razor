@page "/"
@attribute [Authorize]
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Panel Principal | BSC Commerce</PageTitle>

<div class="hero-banner">
    <div class="hero-badge">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
        </svg>
        <span>Portal de Gestión Comercial</span>
    </div>
    <h1>¡Hola de nuevo, @userName!</h1>
    <p>Bienvenido al sistema de administración de ventas en línea. Perfil asignado: <strong>@userRole</strong>.</p>
</div>

<!-- Métricas Rápidas y Tarjetas de Resumen -->
<div class="metrics-grid">
    <div class="metric-card">
        <div class="metric-icon">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                <line x1="12" y1="22.08" x2="12" y2="12"></line>
            </svg>
        </div>
        <div class="metric-content">
            <h3>Catálogo Activo</h3>
            <p class="metric-value">Inventario</p>
        </div>
    </div>

    <div class="metric-card">
        <div class="metric-icon gold">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
            </svg>
        </div>
        <div class="metric-content">
            <h3>Pedidos</h3>
            <p class="metric-value">En Gestión</p>
        </div>
    </div>

    <div class="metric-card">
        <div class="metric-icon">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
            </svg>
        </div>
        <div class="metric-content">
            <h3>Disponibilidad</h3>
            <p class="metric-value">Monitoreo</p>
        </div>
    </div>
</div>

<!-- Accesos Rápidos según Roles -->
<div class="card card-accent-purple">
    <div class="card-header">
        <div>
            <h2>Módulos y Accesos Rápidos</h2>
            <p>Selecciona una opción para gestionar las operaciones del negocio.</p>
        </div>
        <span class="badge badge-purple">@userRole</span>
    </div>

    <div class="action-grid">
        <AuthorizeView Roles="Administrator">
            <Authorized>
                <a href="users" class="action-card">
                    <div class="action-card-info">
                        <h4>Administrar Usuarios</h4>
                        <p>Gestión de cuentas, accesos y permisos del personal</p>
                    </div>
                    <div class="action-card-arrow">→</div>
                </a>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="Administrator,AdministrativeStaff">
            <Authorized>
                <a href="products" class="action-card">
                    <div class="action-card-info">
                        <h4>Catálogo de Productos</h4>
                        <p>Crear, actualizar y consultar artículos a la venta</p>
                    </div>
                    <div class="action-card-arrow">→</div>
                </a>

                <a href="stock" class="action-card">
                    <div class="action-card-info">
                        <h4>Control de Existencias</h4>
                        <p>Consultar niveles de stock y registrar ajustes</p>
                    </div>
                    <div class="action-card-arrow">→</div>
                </a>

                <a href="orders" class="action-card">
                    <div class="action-card-info">
                        <h4>Historial de Pedidos</h4>
                        <p>Revisión, seguimiento y cancelación de pedidos</p>
                    </div>
                    <div class="action-card-arrow">→</div>
                </a>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="Salesperson">
            <Authorized>
                <a href="products" class="action-card">
                    <div class="action-card-info">
                        <h4>Consultar Productos</h4>
                        <p>Ver precios, códigos y existencias disponibles</p>
                    </div>
                    <div class="action-card-arrow">→</div>
                </a>

                <a href="orders/new" class="action-card">
                    <div class="action-card-info">
                        <h4>Generar Nuevo Pedido</h4>
                        <p>Registrar venta con cliente y artículos seleccionados</p>
                    </div>
                    <div class="action-card-arrow">→</div>
                </a>
            </Authorized>
        </AuthorizeView>
    </div>
</div>

@code {
    private string userName = string.Empty;
    private string userRole = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userName = state.User.Identity?.Name ?? "Usuario";
        var role = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
        userRole = role switch
        {
            "Administrator" => "Administrador",
            "AdministrativeStaff" => "Personal administrativo",
            "Salesperson" => "Vendedor",
            _ => "Sin perfil"
        };
    }
}
